# Environment for CI / local-database runs only. Used by docker-compose.ci.yml.
#
# This file is deliberately checked in and contains NO real credentials:
# everything here is a throwaway value for a container that only exists for the
# duration of a smoke test. The real deployment reads backend/.env, which is
# gitignored and excluded from the image by backend/.dockerignore.
#
# Named `ci.env` rather than `.env.ci` because .gitignore blocks `backend/.env.*`
# (rightly — that pattern guards real credentials), and this file must be
# committed for CI to be able to use it.

# The `db` service from docker-compose.ci.yml, reached over the compose network.
# Plain postgres, no TLS: libpq's default sslmode=prefer falls back cleanly.
DATABASE_URL=postgresql://marketmind:marketmind@db:5432/marketmind

# Signing key for JWTs minted during the smoke test. Must be >= 32 chars; it is
# scoped to this run and cannot authenticate against anything real.
JWT_SECRET_KEY=ci-smoke-test-only-signing-key-not-used-in-production

# The smoke test reaches the frontend on port 3000 (nginx) and the Vite dev
# server on 5173 when running outside Docker. Both are allowed so the test
# works in either setup.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP is never contacted by the smoke test; these just satisfy config reads.
SENDER_EMAIL=smoke@example.invalid
SENDER_PASSWORD=unused-in-ci
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
