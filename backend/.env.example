# MarketMind AI - Backend Environment Variables
# Copy this file to .env and replace the placeholder values with your actual credentials.

# Neon PostgreSQL (REQUIRED)
#
# Use the DIRECT endpoint, not the pooled one: drop the "-pooler" label
# from the host Neon shows you (e.g. ep-xxx-pooler.c-4.us-east-2.aws.neon.tech
# -> ep-xxx.c-4.us-east-2.aws.neon.tech). The backend is a single long-lived
# server process with its own SQLAlchemy pool, which is exactly the case the
# pooler is NOT for, and going direct avoids PgBouncer's transaction-mode
# caveats and one more name that can fail to resolve.
#
# Keep sslmode=require (Neon refuses plaintext). channel_binding is left at
# the libpq default (prefer) so a transient SCRAM-PLUS hiccup cannot hard
# fail the handshake.
#
# Rotation: if this credential ever leaks, mint a new password in Neon
# (Console -> Reset password, POST /projects/{id}/branches/{bid}/roles/
# {role}/reset_password with an API key, or ALTER ROLE ... PASSWORD while
# connected as the role), replace it in .env (git-ignored - never commit
# real values), then rebuild and recreate so the stack picks it up:
#   docker compose build backend && docker compose up -d --force-recreate backend
DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require

# JWT Authentication (REQUIRED)
# Use a strong random secret of at least 32 characters.
JWT_SECRET_KEY=your-random-secret-min-32-chars

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email / SMTP (OPTIONAL - for password reset emails)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
