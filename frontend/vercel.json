{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://api-production-14d9b.up.railway.app/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api-production-14d9b.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*/",
      "destination": "https://api-production-14d9b.up.railway.app/uploads/:path*/"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api-production-14d9b.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
