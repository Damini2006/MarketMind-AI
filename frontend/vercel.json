{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "^/api/(.*)$",
      "destination": "https://api-production-14d9b.up.railway.app/api/$1"
    },
    {
      "source": "^/uploads/(.*)$",
      "destination": "https://api-production-14d9b.up.railway.app/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
